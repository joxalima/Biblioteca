@model List<EmprestimoModel>
@{
    ViewData["Title"] = "Index";
}

<div class="container mt-4">
    <h1>Empréstimos</h1>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["MensagemErro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <div class="mb-3">
        <a href="/Emprestimo/EmprestarAluno" class="btn btn-primary">Novo Emprestimo</a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th scope="col">Código</th>
                <th scope="col">Item Emprestado</th>
                <th scope="col">Data Retirada</th>
                <th scope="col">Data Entrega</th>
                <th scope="col">Disponibilidade</th>
                <th scope="col">Aluno</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (EmprestimoModel emprestimo in Model)
                {
                    <tr>
                        <td>@emprestimo.ID</td>
                        <td>@emprestimo.Livro?.Titulo</td>
                        <td>@emprestimo.DataRetirada.ToString()</td>
                        <td>@emprestimo.DataEntrega.ToString()</td>
                        <td><span class="badge bg-danger">Emprestado</span></td>
                        <td>@emprestimo.Aluno?.Nome (RA: @emprestimo.Aluno?.RA)</td>
                        <td>
                            <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editarEmprestimoModal" data-codigo="@emprestimo.ID">Editar</button>
                            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-codigo="@emprestimo.ID">Devolver Livro</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">Nenhum empréstimo encontrado.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal de Confirmação de Devolução -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Confirmar Devolução</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                Tem certeza de que deseja devolver o livro com código <span id="modalStudentCodigo"></span>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <a href="#" id="confirmDeleteButton" class="btn btn-danger">Devolver</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const confirmDeleteModal = document.getElementById('confirmDeleteModal');
        confirmDeleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const codigo = button.getAttribute('data-codigo');

            const modalCodigo = confirmDeleteModal.querySelector('#modalStudentCodigo');
            modalCodigo.textContent = codigo;

            const confirmButton = confirmDeleteModal.querySelector('#confirmDeleteButton');
            confirmButton.href = `/Emprestimo/Devolver?codigo=${codigo}`;
        });
    </script>
}