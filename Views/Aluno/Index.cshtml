
@model List<Aluno>
@{
    ViewData["Title"] = "Index";
}

<div class="container mt-4">
    <h1>Aluno</h1>

    <div class="mb-3">
        <a href="/Aluno/Cadastrar" class="btn btn-primary">Cadastrar Novo Aluno</a>
    </div>

            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col">RA</th>
                        <th scope="col">Nome</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>

    @if (Model != null && Model.Any())
        {
            foreach(Aluno aluno in Model)
            {
                <tbody>
                    <tr>
                        <td>@aluno.RA</td>
                        <td>@aluno.Nome</td>
                        <td>
                            <a href="/Aluno/Editar/@aluno.RA" class="btn btn-warning btn-sm">Editar</a>
                            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-ra="@aluno.RA">Excluir</button>
                        </td>
                    </tr>
                </tbody>
            }
        }
    </table>
</div>

<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Confirmar Exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Tem certeza de que deseja excluir o aluno com RA <span id="modalStudentRA"></span>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <a href="#" id="confirmDeleteButton" class="btn btn-danger">Excluir</a>
            </div>
        </div>
    </div>
</div>

