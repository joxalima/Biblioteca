@model BibliotecaMVC.Models.LivroModel
@{
    ViewData["Title"] = "Editar";
}

<div class="container mt-4">
    <h1>Editar Livro</h1>
    <hr>
    <form asp-controller="Livro" asp-action="Atualizar" method="post">
        <div class="mb-3">
            <label for="codigoLivro" class="form-label">Código do Livro</label>
            <input readonly type="text" class="form-control" id="codigoLivro" asp-for="Codigo" name="Codigo" required>
        </div>
        <div class="mb-3">
            <label for="tituloLivro" class="form-label">Título</label>
            <input type="text" class="form-control" id="tituloLivro" asp-for="Titulo" name="Titulo" required>
        </div>
        <div class="mb-3">
            <label for="autorLivro" class="form-label">Autor</label>
            <input type="text" class="form-control" id="autorLivro" asp-for="Autor" name="Autor" required>
        </div>
        <div class="mb-3">
            <label for="categoriaLivro" class="form-label">Categoria</label>
            <input type="text" class="form-control" id="categoriaLivro" asp-for="Categoria"name ="Categoria" required>
        </div>
        <div class="mb-3">
            <label for="editoraLivro" class="form-label">Editora</label>
            <input type="text" class="form-control" id="editoraLivro" asp-for="Editora" name ="Editora" required>
        </div>
        <button type="submit" class="btn btn-primary">Atualizar</button>
        <a href="/Livro" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

