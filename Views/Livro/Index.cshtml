@model List<LivroModel>
@{
    ViewData["Title"] = "Index";
}


    <div class="container mt-4">
        <h1>Livros</h1>

    <div class="mb-3">
        <a href="/Livro/Cadastrar" class="btn btn-primary">Cadastrar Novo Livro</a>
    </div>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Título</th>
                    <th scope="col">Autor</th>
                    <th scope="col">Categoria</th>
                    <th scope="col">Editora</th>
                    <th scope="col">Ações</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                foreach(LivroModel livro in Model)
                {    
                <tr>
                    <td>@livro.Codigo</td>
                    <td>@livro.Titulo</td>
                    <td>@livro.Autor</td>
                    <td>@livro.Categoria</td>
                    <td>@livro.Editora</td>
                    <td>
                        <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editarLivroModal" data-codigo="@livro.Codigo">Editar</button>
                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#confirmDeleteLivroModal" data-codigo="@livro.Codigo">Excluir</button>
                    </td>
                </tr>
                }
            }
            </tbody>
        </table>
    </div>


