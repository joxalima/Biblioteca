    <div class="modal fade" id="confirmDeleteLivroModal" tabindex="-1" aria-labelledby="confirmDeleteLivroModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmDeleteLivroModalLabel">Confirmar Exclusão</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Tem certeza de que deseja excluir o livro com código: <span id="modalLivroCodigo"></span>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <a href="#" id="confirmDeleteLivroButton" class="btn btn-danger">Excluir</a>
                </div>
            </div>
        </div>
    </div>

